{
  "name": "copilot-trace-importer",
  "version": "0.1.0",
  "description": "Import GitHub Copilot session events from local SQLite databases, JSONL files, and VS Code debug logs into a normalized, redacted local datastore",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "copilot-trace-importer": "dist/bin/ingest.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "datastore:import": "tsx bin/ingest.ts import",
    "datastore:summary": "tsx bin/ingest.ts summary"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.2"
  }
}
